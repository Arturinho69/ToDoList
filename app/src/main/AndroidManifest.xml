        <activity
            android:name=".ui.TareasActivity"
            android:exported="false" />

        <activity
            android:name=".ui.CategoriasActivity"
            android:exported="false" />

        <activity
            android:name=".ui.PerfilActivity"
            android:exported="false" />

        <activity
            android:name=".ui.EditarPerfilActivity"
            android:exported="false" />

        <activity
            android:name=".ui.CambiarClaveActivity"
            android:exported="false" />

        <activity
            android:name=".ui.NotificacionesActivity"
            android:exported="false" />

    </application>

</manifest>
