<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FAF6F1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recuperar contraseña"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#7048AB"/>

        <TextView
            android:id="@+id/explicacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Modo local: escribe el correo de tu cuenta y una contraseña nueva. Aun no se envía ningún correo."
            android:textSize="14sp"
            android:textColor="#75677E"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="8dp"
            android:text="Correo electrónico"
            android:textSize="14sp"
            android:textColor="#382B46"/>

        <EditText
            android:id="@+id/txtCorreo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="#FFFFFF"
            android:hint="Escribe tu correo electrónico"
            android:inputType="textEmailAddress"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:singleLine="true"
            android:textColor="#382B46"
            android:textColorHint="#75677E"
            android:textSize="15sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="Nueva contraseña"
            android:textSize="14sp"
            android:textColor="#382B46"/>

        <EditText
            android:id="@+id/txtClaveNueva"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="#FFFFFF"
            android:hint="Escribe tu nueva contraseña"
            android:inputType="textPassword"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:singleLine="true"
            android:textColor="#382B46"
            android:textColorHint="#75677E"
            android:textSize="15sp"/>

        <Button
            android:id="@+id/btnRecuperarClave"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="30dp"
            android:backgroundTint="#7048AB"
            android:text="CAMBIAR CONTRASEÑA"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textSize="15sp"/>

        <Button
            android:id="@+id/btnAtras"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#867591"
            android:text="Volver"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textSize="15sp"/>

    </LinearLayout>

</ScrollView>
